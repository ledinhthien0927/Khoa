--- !u!114 &1975909434
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1975909432}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f19c4041ee66c0249b65d8ea5dbdacc3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCController
  npcName: "Ho\xE0ng t\u1EED"
  interactDistance: 2
  interactKey: 102
  interactHint: {fileID: 0}
  actor: {fileID: 0}
  introDialogue:
  - speaker: "Ho\xE0ng t\u1EED"
    text: "Ng\u01B0\u01A1i nh\xECn xem... C\u1EDD c\u1EE7a Malric \u0111\xE3 c\u1EAFm
      tr\xEAn \u0111\u1EC9nh th\xE1p canh. H\u1EAFn g\u1ECDi \u0111\xF3 l\xE0 'Ng\u1ECDn
      l\u1EEDa Thanh l\u1ECDc', nh\u01B0ng ta ch\u1EC9 th\u1EA5y s\u1EF1 ph\u1EA3n
      b\u1ED9i ch\xE1y r\u1EF1c."
    focusTarget: {fileID: 2125860975}
    showAccept: 0
    actor: {fileID: 0}
    animationTrigger: 
  - speaker: "Ho\xE0ng t\u1EED"
    text: "Ch\xFAng ta \u0111\xE3 m\u1EA5t V\u01B0\u01A1ng Mi\u1EC7n S\u1EAFt. L\xEDnh
      c\u1EE7a ta \u0111\xE3 ch\u1EBFt, ho\u1EB7c \u0111\u1EA7u h\xE0ng. Gi\u1EDD
      \u0111\xE2y, hy v\u1ECDng duy nh\u1EA5t c\u1EE7a d\xF2ng t\u1ED9c n\u1EB1m
      trong tay ng\u01B0\u01A1i."
    focusTarget: {fileID: 2125860975}
    showAccept: 0
    actor: {fileID: 0}
    animationTrigger: 
  - speaker: "Ho\xE0ng t\u1EED"
    text: "\u0110\xE2y l\xE0 Th\xE1nh Kh\xED c\u1EE7a t\u1ED5 ti\xEAn ta. N\xF3 \u0111\xE3
      v\u1EE1 n\xE1t khi ta c\u1ED1 \u0111\u1EE1 \u0111\xF2n c\u1EE7a t\xEAn \u0110\u1EA1i
      C\xF4ng T\u01B0\u1EDBc \u0111i\xEAn cu\u1ED3ng \u0111\xF3."
    focusTarget: {fileID: 2125860975}
    showAccept: 0
    actor: {fileID: 0}
    animationTrigger: 
  - speaker: "Ho\xE0ng t\u1EED"
    text: "H\xE3y \u0111em n\xF3 \u0111\u1EBFn \u0111e r\xE8n. H\u1ED3i ph\u1EE5c
      l\u1EA1i linh h\u1ED3n cho n\xF3. \u0110\u1EEBng \u0111\u1EC3 ng\u1ECDn l\u1EEDa
      cu\u1ED1i c\xF9ng c\u1EE7a ch\xFAng ta l\u1EE5i t\xE0n."
    focusTarget: {fileID: 2125860975}
    showAccept: 0
    actor: {fileID: 0}
    animationTrigger: 
  remindSwordDialogue:
  - speaker: "Ho\xE0ng t\u1EED"
    text: "Ng\u01B0\u01A1i v\u1EABn ch\u01B0a s\u1EEDa ki\u1EBFm xong sao?"
    focusTarget: {fileID: 0}
    showAccept: 0
    actor: {fileID: 0}
    animationTrigger: 
  finishSwordDialogue:
  - speaker: 
    text: "Nh\u01B0ng n\u1EBFu mu\u1ED1n \u0111i l\u1EA5y l\u1EA1i v\u01B0\u01A1ng
      mi\u1EC7ng, ch\xFAng ta c\u1EA7n s\u1EEDa l\u1EA1i chi\u1EBFc thuy\u1EC3n \u0111\xE3
      b\u1ECB h\u01B0 h\u1EA1i."
    focusTarget: {fileID: 0}
    showAccept: 0
    actor: {fileID: 0}
    animationTrigger: 
