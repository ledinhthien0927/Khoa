    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: boatMissionDialogue.Array.data[0].text
      value: "Nh\u01B0ng cu\u1ED9c h\xE0nh tr\xECnh ch\u01B0a k\u1EBFt th\xFAc."
      objectReference: {fileID: 0}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: boatMissionDialogue.Array.data[1].text
      value: "Con thuy\u1EC1n chi\u1EBFn c\u1EE7a ta \u0111\xE3 h\u01B0 h\u1ECFng."
      objectReference: {fileID: 0}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: boatMissionDialogue.Array.data[2].text
      value: "H\xE3y s\u1EEDa n\xF3, ch\xFAng ta c\u1EA7n ra kh\u01A1i ngay!"
      objectReference: {fileID: 0}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: shipMissionDialogue.Array.data[0].text
      value: "Nh\u01B0ng m\u1ECDi chuy\u1EC7n v\u1EABn ch\u01B0a xong !"
      objectReference: {fileID: 0}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: shipMissionDialogue.Array.data[1].text
      value: "Hi\u1EC7n t\u1EA1i ch\u01B0a c\xF3 ph\u01B0\u01A1ng ti\u1EC7n di chuy\u1EC3n
        v\xE0 ch\u1EC9 c\xF2n s\xF3t l\u1EA1i con t\xE0u b\u1ECB v\u1EE1 v\u1EE5n
        \u0111\u1EB1ng lkia."
      objectReference: {fileID: 0}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: shipMissionDialogue.Array.data[2].text
      value: "Ng\u01B0\u01A1i h\xE3y gi\xFAp ta s\u1EEDa l\u1EA1i ch\xFAng nh\xE9,
        ta tin v\xE0o k\u1EBFt qu\u1EA3 t\u1ED1t c\u1EE7a ng\u01B0\u01A1i."
      objectReference: {fileID: 0}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: hammerIntro.Array.data[0].dialogueEvent
      value: 0
      objectReference: {fileID: 0}
