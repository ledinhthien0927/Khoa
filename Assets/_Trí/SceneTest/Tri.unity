--- !u!1001 &5103241210449388541
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 1416920589729658605, guid: 764c9079c57013b47a99793cfe3773ad, type: 3}
      propertyPath: actor
      value: 
      objectReference: {fileID: 1873496038}
    - target: {fileID: 1416920589729658605, guid: 764c9079c57013b47a99793cfe3773ad, type: 3}
      propertyPath: npcName
      value: "Ng\u01B0\u1EDDi ch\u1EA1y n\u1EA1n"
      objectReference: {fileID: 0}
    - target: {fileID: 1416920589729658605, guid: 764c9079c57013b47a99793cfe3773ad, type: 3}
      propertyPath: refugeeDialogue.Array.size
      value: 12
      objectReference: {fileID: 0}
    - target: {fileID: 1416920589729658605, guid: 764c9079c57013b47a99793cfe3773ad, type: 3}
      propertyPath: refugeeDialogue.Array.data[0].text
      value: "\u0110\u1EA3o th\u1EE9 2 v\xE0 th\u1EE9 3 \u01B0?"
      objectReference: {fileID: 0}
    - target: {fileID: 1416920589729658605, guid: 764c9079c57013b47a99793cfe3773ad, type: 3}
      propertyPath: refugeeDialogue.Array.data[1].text
      value: "C\u1EADu \u0111i\xEAn r\u1ED3i!"
      objectReference: {fileID: 0}
    - target: {fileID: 1416920589729658605, guid: 764c9079c57013b47a99793cfe3773ad, type: 3}
      propertyPath: refugeeDialogue.Array.data[2].text
      value: "\u0110\u1EEBng \u0111\u1EBFn \u0111\xF3 n\u1EBFu mu\u1ED1n gi\u1EEF
        m\u1EA1ng!"
      objectReference: {fileID: 0}
    - target: {fileID: 1416920589729658605, guid: 764c9079c57013b47a99793cfe3773ad, type: 3}
      propertyPath: refugeeDialogue.Array.data[3].text
      value: "T\xF4i... t\xF4i v\u1EEBa tr\u1ED1n tho\xE1t kh\u1ECFi \u0110\u1EA3o
        th\u1EE9 3."
      objectReference: {fileID: 0}
    - target: {fileID: 1416920589729658605, guid: 764c9079c57013b47a99793cfe3773ad, type: 3}
      propertyPath: refugeeDialogue.Array.data[4].text
      value: "\u0110\u1ECBa ng\u1EE5c! \u0110\xF3 l\xE0 \u0111\u1ECBa ng\u1EE5c!"
      objectReference: {fileID: 0}
    - target: {fileID: 1416920589729658605, guid: 764c9079c57013b47a99793cfe3773ad, type: 3}
      propertyPath: refugeeDialogue.Array.data[5].text
      value: "Qu\xE2n \u0111o\xE0n c\u1EE7a \u0110\u1EA1i C\xF4ng T\u01B0\u1EDBc
        Malric \u0111\xE3 chi\u1EBFm \u0111\xF3ng c\u1EA3 hai h\xF2n \u0111\u1EA3o
        \u0111\xF3 r\u1ED3i."
      objectReference: {fileID: 0}
    - target: {fileID: 1416920589729658605, guid: 764c9079c57013b47a99793cfe3773ad, type: 3}
      propertyPath: refugeeDialogue.Array.data[6].text
      value: "B\u1ECDn ch\xFAng l\xF9ng s\u1EE5c kh\u1EAFp n\u01A1i, t\xE0n s\xE1t
        b\u1EA5t c\u1EE9 ai ch\u1ED1ng \u0111\u1ED1i."
      objectReference: {fileID: 0}
    - target: {fileID: 1416920589729658605, guid: 764c9079c57013b47a99793cfe3773ad, type: 3}
      propertyPath: refugeeDialogue.Array.data[7].text
      value: "\xD4ng l\xE0 ai?"
      objectReference: {fileID: 0}
    - target: {fileID: 1416920589729658605, guid: 764c9079c57013b47a99793cfe3773ad, type: 3}
      propertyPath: refugeeDialogue.Array.data[8].text
      value: "T\u1EA1i sao l\u1EA1i c\u1EA3n t\xF4i ?"
      objectReference: {fileID: 0}
    - target: {fileID: 1416920589729658605, guid: 764c9079c57013b47a99793cfe3773ad, type: 3}
      propertyPath: refugeeDialogue.Array.data[9].text
      value: "T\xF4i nghe l\xE9n \u0111\u01B0\u1EE3c r\u1EB1ng ch\xFAng \u0111\xE3
        t\xECm th\u1EA5y c\xE1c 'M\u1EA3nh V\u1EE1' v\xE0 \u0111ang canh gi\u1EEF
        nghi\xEAm ng\u1EB7t \u0111\u1EC3 ph\u1EE5c v\u1EE5 cho m\u01B0u \u0111\u1ED3
        \u0111en t\u1ED1i c\u1EE7a Malric."
      objectReference: {fileID: 0}
    - target: {fileID: 1416920589729658605, guid: 764c9079c57013b47a99793cfe3773ad, type: 3}
      propertyPath: refugeeDialogue.Array.data[10].text
      value: "Nh\u01B0ng... Tr\u01B0\u1EDFng l\xE0ng \u01A1i, bao \u0111\u1EDDi nay
        \u0111\xE2u c\xF3 ai m\u1EDF \u0111\u01B0\u1EE3c n\xF3?"
      objectReference: {fileID: 0}
    - target: {fileID: 1416920589729658605, guid: 764c9079c57013b47a99793cfe3773ad, type: 3}
      propertyPath: refugeeDialogue.Array.data[11].text
      value: "C\xE1i kh\xF3a c\u1ED5 ng\u1EEF \u0111\xF3 qu\xE1 ph\u1EE9c t\u1EA1p."
      objectReference: {fileID: 0}
    - target: {fileID: 1416920589729658605, guid: 764c9079c57013b47a99793cfe3773ad, type: 3}
      propertyPath: refugeeDialogue.Array.data[7].speaker
      value: "B\u1EA1n"
      objectReference: {fileID: 0}
    - target: {fileID: 1416920589729658605, guid: 764c9079c57013b47a99793cfe3773ad, type: 3}
      propertyPath: refugeeDialogue.Array.data[8].speaker
      value: "B\u1EA1n"
      objectReference: {fileID: 0}
    - target: {fileID: 1416920589729658605, guid: 764c9079c57013b47a99793cfe3773ad, type: 3}
      propertyPath: refugeeDialogue.Array.data[10].speaker
      value: "Ng\u01B0\u1EDDi ch\u1EA1y n\u1EA1n"
      objectReference: {fileID: 0}
    - target: {fileID: 1416920589729658605, guid: 764c9079c57013b47a99793cfe3773ad, type: 3}
      propertyPath: refugeeDialogue.Array.data[11].speaker
      value: "Ng\u01B0\u1EDDi ch\u1EA1y n\u1EA1n"
