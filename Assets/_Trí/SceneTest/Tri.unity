    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: scene1Dialogue.Array.data[6].text
      value: "C\u1EADu c\xF3 th\u1EC3 gi\xFAp t\xF4i xua tan lu\u1ED3ng kh\xED t\xE0
        \xE1c \u0111\u01B0\u1EE3c kh\xF4ng ?"
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: scene3Dialogue.Array.data[0].text
      value: "L\u1EEF kh\xE1ch, n\u1EBFu c\u1EADu th\u1EF1c s\u1EF1 mu\u1ED1n \u0111\u1ED1i
        \u0111\u1EA7u v\u1EDBi Malric v\xE0 \u0111o\u1EA1t l\u1EA1i c\xE1c m\u1EA3nh
        v\u1EE1, s\u1EE9c m\u1EA1nh b\xECnh th\u01B0\u1EDDng l\xE0 kh\xF4ng \u0111\u1EE7
        \u0111\xE2u."
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: scene3Dialogue.Array.data[1].text
      value: "\u0110\xE2y l\xE0 b\xE1u v\u1EADt \u0111\u01B0\u1EE3c truy\u1EC1n l\u1EA1i
        qua bao \u0111\u1EDDi tr\u01B0\u1EDFng l\xE0ng c\u1EE7a ch\xFAng t\xF4i."
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: scene3Dialogue.Array.data[2].text
      value: "T\u01B0\u01A1ng truy\u1EC1n, b\xEAn trong ch\u1EE9a m\u1ED9t v\u0169
        kh\xED mang s\u1EE9c m\u1EA1nh tinh thu\u1EA7n, kh\u1EAFc tinh c\u1EE7a m\u1ECDi
        lo\u1EA1i h\u1EAFc kh\xED."
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: scene3Dialogue.Array.data[3].text
      value: "\u0110\xFAng v\u1EADy, ch\xFAng t\xF4i kh\xF4ng \u0111\u1EE7 tr\xED
        tu\u1EC7 \u0111\u1EC3 gi\u1EA3i m\xE3 n\xF3."
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: scene3Dialogue.Array.data[4].text
      value: "Nh\u01B0ng c\u1EADu... ng\u01B0\u1EDDi \u0111\xE3 thanh t\u1EA9y \u0111\u01B0\u1EE3c
        h\u1EAFc kh\xED ngo\xE0i kia, c\xF3 th\u1EC3 c\u1EADu ch\xEDnh l\xE0 ng\u01B0\u1EDDi
        \u0111\u01B0\u1EE3c ch\u1ECDn."
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: scene3Dialogue.Array.data[5].text
      value: "Nh\u01B0ng c\u1EADu... ng\u01B0\u1EDDi \u0111\xE3 thanh t\u1EA9y \u0111\u01B0\u1EE3c
        h\u1EAFc kh\xED ngo\xE0i kia, c\xF3 th\u1EC3 c\u1EADu ch\xEDnh l\xE0 ng\u01B0\u1EDDi
        \u0111\u01B0\u1EE3c ch\u1ECDn."
      objectReference: {fileID: 0}
