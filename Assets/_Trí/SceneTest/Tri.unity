      objectReference: {fileID: 0}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: hammerIntro.Array.data[8].dialogueEvent
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: hammerCompleteDialogue.Array.data[0].text
      value: "Th\u1EADt tuy\u1EC7t v\u1EDDi !"
      objectReference: {fileID: 0}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: hammerCompleteDialogue.Array.data[1].text
      value: "Ng\u01B0\u01A1i \u0111\xE3 r\xE8n \u0111\u01B0\u1EE3c Th\xE1nh Kh\xED
        qu\xFD hi\u1EBFm n\xE0y cho ta, ta r\u1EA5t \u0111\u1ED9i \u01A1n."
      objectReference: {fileID: 0}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
