    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: scene2ThanksDialogue.Array.data[0].text
      value: "Th\u1EA7n linh \u01A1i!"
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: scene2ThanksDialogue.Array.data[1].text
      value: "Nh\xECn k\xECa, b\u1EA7u tr\u1EDDi \u0111\xE3 trong xanh tr\u1EDF l\u1EA1i."
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: scene2ThanksDialogue.Array.data[2].text
      value: "C\u1EADu \u0111\xE3 c\u1EE9u s\u1ED1ng c\u1EA3 ng\xF4i l\xE0ng n\xE0y."
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: scene2ThanksDialogue.Array.data[3].text
      value: "Ch\xFAng t\xF4i mang \u01A1n c\u1EADu m\xE3i m\xE3i!"
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: scene2ThanksDialogue.Array.data[4].text
      value: "Kh\xF4ng c\xF3 g\xEC."
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: scene2ThanksDialogue.Array.data[5].text
      value: "Nh\u01B0ng h\xE0nh tr\xECnh c\u1EE7a t\xF4i ch\u01B0a k\u1EBFt th\xFAc."
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: scene2ThanksDialogue.Array.data[6].text
      value: "T\xF4i c\u1EA7n \u0111\u1EBFn \u0110\u1EA3o th\u1EE9 2 v\xE0 th\u1EE9
        3 t\xECm nh\u1EEFng m\u1EA3nh v\u1EE1 c\xF2n l\u1EA1i."
      objectReference: {fileID: 0}
