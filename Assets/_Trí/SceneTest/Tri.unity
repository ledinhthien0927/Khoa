    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: warning.Array.data[0].text
      value: "C\u1EA9n th\u1EADn!"
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: warning.Array.data[1].text
      value: "C\u1EA9n th\u1EADn!"
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: warning.Array.data[2].text
      value: " H\u1EAFc kh\xED \u0111\xF3 kh\xF4ng ch\u1EC9 \u0103n m\xF2n th\u1EC3
        x\xE1c m\xE0 c\xF2n thao t\xFAng t\xE2m tr\xED."
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: warning.Array.data[3].text
      value: "H\xE3y b\u1EA3o tr\u1ECDng!"
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: cleared.Array.data[10].text
      value: "T\u1EA1i sao l\u1EA1i c\u1EA3n t\xF4i ? "
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: cleared.Array.data[11].text
      value: "T\xF4i... t\xF4i v\u1EEBa tr\u1ED1n tho\xE1t kh\u1ECFi \u0110\u1EA3o
        th\u1EE9 3."
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: cleared.Array.data[12].text
      value: "\u0110\u1ECBa ng\u1EE5c! \u0110\xF3 l\xE0 \u0111\u1ECBa ng\u1EE5c!\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: cleared.Array.data[13].text
      value: "Qu\xE2n \u0111o\xE0n c\u1EE7a \u0110\u1EA1i C\xF4ng T\u01B0\u1EDBc
        Malric \u0111\xE3 chi\u1EBFm \u0111\xF3ng c\u1EA3 hai h\xF2n \u0111\u1EA3o
        \u0111\xF3 r\u1ED3i. "
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: cleared.Array.data[14].text
      value: "B\u1ECDn ch\xFAng l\xF9ng s\u1EE5c kh\u1EAFp n\u01A1i, t\xE0n s\xE1t
        b\u1EA5t c\u1EE9 ai ch\u1ED1ng \u0111\u1ED1i. "
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: cleared.Array.data[15].text
      value: "T\xF4i nghe l\xE9n \u0111\u01B0\u1EE3c r\u1EB1ng ch\xFAng \u0111\xE3
        t\xECm th\u1EA5y c\xE1c 'M\u1EA3nh V\u1EE1' v\xE0 \u0111ang canh gi\u1EEF
        nghi\xEAm ng\u1EB7t \u0111\u1EC3 ph\u1EE5c v\u1EE5 cho m\u01B0u \u0111\u1ED3
        \u0111en t\u1ED1i c\u1EE7a Malric."
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: cleared.Array.data[16].text
      value: Malric?
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: cleared.Array.data[17].text
      value: "T\xEAn b\u1EA1o ch\xFAa \u0111\xF3 mu\u1ED1n d\xF9ng s\u1EE9c m\u1EA1nh
        c\u1EE7a c\xE1c m\u1EA3nh v\u1EE1 sao?"
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: cleared.Array.data[18].text
      value: "Nguy to r\u1ED3i...!!!"
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: cleared.Array.data[19].text
      value: "Nguy to r\u1ED3i...!!!"
