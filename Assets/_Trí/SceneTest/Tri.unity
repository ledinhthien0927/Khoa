      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: malricDialogue.text
      value: "Malric? T\xEAn b\u1EA1o ch\xFAa \u0111\xF3 mu\u1ED1n d\xF9ng s\u1EE9c
        m\u1EA1nh c\u1EE7a c\xE1c m\u1EA3nh v\u1EE1 sao? Nguy to r\u1ED3i..."
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: done.Array.data[0].text
      value: "Tuy\u1EC7t v\u1EDDi!"
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: done.Array.data[1].text
      value: "Truy\u1EC1n thuy\u1EBFt l\xE0 c\xF3 th\u1EADt."
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: done.Array.data[2].text
      value: "H\xE3y l\xEAn \u0111\u01B0\u1EDDng b\xECnh an, l\u1EEF kh\xE1ch!"
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: done.Array.data[1].actor
      value: 
      objectReference: {fileID: 2059121638}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: intro.Array.data[0].text
      value: "H\u1EE1i l\u1EEF kh\xE1ch ph\u01B0\u01A1ng xa, c\u1EADu \u0111\u1EBFn
        \u0111\xE2y kh\xF4ng \u0111\xFAng l\xFAc r\u1ED3i."
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: intro.Array.data[1].text
      value: "Ng\xF4i l\xE0ng b\xECnh y\xEAn c\u1EE7a ch\xFAng t\xF4i \u0111ang ch\u1EBFt
        d\u1EA7n."
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: intro.Array.data[2].text
      value: "C\xE1ch \u0111\xE2y v\xE0i ng\xE0y, m\u1ED9t v\u1EADt th\u1EC3 l\u1EA1
        t\u1EEB tr\xEAn tr\u1EDDi r\u01A1i xu\u1ED1ng khu r\u1EEBng ph\xEDa B\u1EAFc."
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: intro.Array.data[3].text
      value: "K\u1EC3 t\u1EEB \u0111\xF3, m\u1ED9t lu\u1ED3ng h\u1EAFc kh\xED t\xE0
        \xE1c t\u1ECFa ra t\u1EEB n\xF3."
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: intro.Array.data[4].text
      value: "C\xE2y c\u1ED1i bi\u1EBFn d\u1ECB, \u0111\u1EA5t \u0111ai n\u1EE9t
        to\xE1c, ngay c\u1EA3 nh\u1EEFng con th\xFA hi\u1EC1n l\xE0nh nh\u1EA5t c\u0169ng
        tr\u1EDF n\xEAn \u0111i\xEAn lo\u1EA1n v\xE0 kh\xE1t m\xE1u."
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: intro.Array.data[5].text
      value: "N\u1EBFu kh\xF4ng ai ph\xE1 h\u1EE7y ngu\u1ED3n n\u0103ng l\u01B0\u1EE3ng
        \u0111\xF3, h\xF2n \u0111\u1EA3o n\xE0y s\u1EBD b\u1ECB nu\u1ED1t ch\u1EEDng."
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: intro.Array.data[6].text
      value: "C\u1EADu c\xF3 th\u1EC3 gi\xFAp t\xF4i xua tan lu\u1ED3ng kh\xED t\xE0
        \xE1c \u0111\u01B0\u1EE3c kh\xF4ng ?\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: quest.Array.data[0].text
      value: "C\u1EADu c\xF3 th\u1EC3 gi\xFAp t\xF4i xua tan lu\u1ED3ng kh\xED t\xE0
        \xE1c \u0111\u01B0\u1EE3c kh\xF4ng ?\n"
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: intro.Array.data[0].actor
      value: 
      objectReference: {fileID: 2059121638}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: intro.Array.data[1].actor
      value: 
      objectReference: {fileID: 2059121638}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: intro.Array.data[4].actor
      value: 
      objectReference: {fileID: 2059121638}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: quest.Array.data[0].actor
      value: 
      objectReference: {fileID: 2059121638}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: reward.Array.data[0].text
      value: "L\u1EEF kh\xE1ch, n\u1EBFu c\u1EADu th\u1EF1c s\u1EF1 mu\u1ED1n \u0111\u1ED1i
        \u0111\u1EA7u v\u1EDBi Malric v\xE0 \u0111o\u1EA1t l\u1EA1i c\xE1c m\u1EA3nh
        v\u1EE1, s\u1EE9c m\u1EA1nh b\xECnh th\u01B0\u1EDDng l\xE0 kh\xF4ng \u0111\u1EE7
        \u0111\xE2u."
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: reward.Array.data[1].text
      value: "\u0110\xE2y l\xE0 b\xE1u v\u1EADt \u0111\u01B0\u1EE3c truy\u1EC1n l\u1EA1i
        qua bao \u0111\u1EDDi tr\u01B0\u1EDFng l\xE0ng c\u1EE7a ch\xFAng t\xF4i."
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: reward.Array.data[2].text
      value: "T\u01B0\u01A1ng truy\u1EC1n, b\xEAn trong ch\u1EE9a m\u1ED9t v\u0169
        kh\xED mang s\u1EE9c m\u1EA1nh tinh thu\u1EA7n, kh\u1EAFc tinh c\u1EE7a m\u1ECDi
        lo\u1EA1i h\u1EAFc kh\xED."
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: reward.Array.data[3].text
      value: "Nh\u01B0ng... Tr\u01B0\u1EDFng l\xE0ng \u01A1i, bao \u0111\u1EDDi nay
        \u0111\xE2u c\xF3 ai m\u1EDF \u0111\u01B0\u1EE3c n\xF3?"
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: reward.Array.data[4].text
      value: "C\xE1i kh\xF3a c\u1ED5 ng\u1EEF \u0111\xF3 qu\xE1 ph\u1EE9c t\u1EA1p."
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: reward.Array.data[5].text
      value: "\u0110\xFAng v\u1EADy, ch\xFAng t\xF4i kh\xF4ng \u0111\u1EE7 tr\xED
        tu\u1EC7 \u0111\u1EC3 gi\u1EA3i m\xE3 n\xF3."
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: reward.Array.data[6].text
      value: "\u0110\xFAng v\u1EADy, ch\xFAng t\xF4i kh\xF4ng \u0111\u1EE7 tr\xED
        tu\u1EC7 \u0111\u1EC3 gi\u1EA3i m\xE3 n\xF3."
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: reward.Array.data[7].text
      value: "Nh\u01B0ng c\u1EADu... ng\u01B0\u1EDDi \u0111\xE3 thanh t\u1EA9y \u0111\u01B0\u1EE3c
        h\u1EAFc kh\xED ngo\xE0i kia, c\xF3 th\u1EC3 c\u1EADu ch\xEDnh l\xE0 ng\u01B0\u1EDDi
        \u0111\u01B0\u1EE3c ch\u1ECDn."
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: reward.Array.data[8].text
      value: "H\xE3y th\u1EED xem. N\u1EBFu m\u1EDF \u0111\u01B0\u1EE3c, n\xF3 l\xE0
        c\u1EE7a c\u1EADu."
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: reward.Array.data[9].text
      value: "H\xE3y d\xF9ng n\xF3 \u0111\u1EC3 ng\u0103n ch\u1EB7n Malric!"
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: scene1.Array.data[0].text
      value: "H\u1EE1i l\u1EEF kh\xE1ch ph\u01B0\u01A1ng xa, c\u1EADu \u0111\u1EBFn
        \u0111\xE2y kh\xF4ng \u0111\xFAng l\xFAc r\u1ED3i."
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: scene1.Array.data[1].text
      value: "Ng\xF4i l\xE0ng b\xECnh y\xEAn c\u1EE7a ch\xFAng t\xF4i \u0111ang ch\u1EBFt
        d\u1EA7n."
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: scene1.Array.data[2].text
      value: "C\xE1ch \u0111\xE2y v\xE0i ng\xE0y, m\u1ED9t v\u1EADt th\u1EC3 l\u1EA1
        t\u1EEB tr\xEAn tr\u1EDDi r\u01A1i xu\u1ED1ng khu r\u1EEBng ph\xEDa B\u1EAFc."
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: scene1.Array.data[3].text
      value: "K\u1EC3 t\u1EEB \u0111\xF3, m\u1ED9t lu\u1ED3ng h\u1EAFc kh\xED t\xE0
        \xE1c t\u1ECFa ra t\u1EEB n\xF3."
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: scene1.Array.data[4].text
      value: "C\xE2y c\u1ED1i bi\u1EBFn d\u1ECB, \u0111\u1EA5t \u0111ai n\u1EE9t
        to\xE1c, ngay c\u1EA3 nh\u1EEFng con th\xFA hi\u1EC1n l\xE0nh nh\u1EA5t c\u0169ng
        tr\u1EDF n\xEAn \u0111i\xEAn lo\u1EA1n v\xE0 kh\xE1t m\xE1u."
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: scene1.Array.data[5].text
      value: "N\u1EBFu kh\xF4ng ai ph\xE1 h\u1EE7y ngu\u1ED3n n\u0103ng l\u01B0\u1EE3ng
        \u0111\xF3, h\xF2n \u0111\u1EA3o n\xE0y s\u1EBD b\u1ECB nu\u1ED1t ch\u1EEDng."
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: scene1.Array.data[6].text
      value: "C\u1EADu c\xF3 th\u1EC3 gi\xFAp t\xF4i xua tan lu\u1ED3ng kh\xED t\xE0
        \xE1c \u0111\u01B0\u1EE3c kh\xF4ng ?"
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: scene3Dialogue.Array.size
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: cleared.Array.data[0].text
      value: "Th\u1EA7n linh \u01A1i!"
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: cleared.Array.data[1].text
      value: "Nh\xECn k\xECa, b\u1EA7u tr\u1EDDi \u0111\xE3 trong xanh tr\u1EDF l\u1EA1i."
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: cleared.Array.data[2].text
      value: "C\u1EADu \u0111\xE3 c\u1EE9u s\u1ED1ng c\u1EA3 ng\xF4i l\xE0ng n\xE0y."
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: cleared.Array.data[3].text
      value: "Ch\xFAng t\xF4i mang \u01A1n c\u1EADu m\xE3i m\xE3i!"
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: cleared.Array.data[4].text
      value: "Kh\xF4ng c\xF3 g\xEC."
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: cleared.Array.data[5].text
      value: "Nh\u01B0ng h\xE0nh tr\xECnh c\u1EE7a t\xF4i ch\u01B0a k\u1EBFt th\xFAc."
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: cleared.Array.data[6].text
      value: "T\xF4i c\u1EA7n \u0111\u1EBFn \u0110\u1EA3o th\u1EE9 2 v\xE0 th\u1EE9
        3 t\xECm nh\u1EEFng m\u1EA3nh v\u1EE1 c\xF2n l\u1EA1i"
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: cleared.Array.data[7].text
      value: "\u0110\u1EA3o th\u1EE9 2 v\xE0 th\u1EE9 3 \u01B0?"
      objectReference: {fileID: 0}
    - target: {fileID: 3919003259199020526, guid: 9b1fc2710ca7b5d49ae4c7326717fd60, type: 3}
      propertyPath: cleared.Array.data[8].text
      value: "C\u1EADu \u0111i\xEAn r\u1ED3i!"
      objectReference: {fileID: 0}
