      propertyPath: cameraFocusPoint
      value: 
      objectReference: {fileID: 286027473668887138}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: idleDialogue.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: dialogueLines.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: introDialogue.Array.size
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: 'idleDialogue.Array.data[0]'
      value: "Th\u1EDDi gian kh\xF4ng ch\u1EDD \u0111\u1EE3i \u0111\xE2u."
      objectReference: {fileID: 0}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: 'idleDialogue.Array.data[1]'
      value: "Ti\u1EBFng b\xFAa c\u1EE7a ng\u01B0\u01A1i l\xE0 \xE2m thanh duy nh\u1EA5t
        khi\u1EBFn ta an l\xF2ng l\xFAc n\xE0y, h\xE3y \u0111i \u0111i."
      objectReference: {fileID: 0}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: missionDialogue.Array.size
      value: 9
      objectReference: {fileID: 0}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: completeDialogue.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: 'dialogueLines.Array.data[0]'
      value: "Th\xE1nh kh\xED (C\xE2y b\xFAa) \u0111\xE3 h\u1ECFng."
      objectReference: {fileID: 0}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: 'dialogueLines.Array.data[1]'
      value: "H\xE3y s\u1EEDa n\xF3 v\xE0 thu th\u1EADp v\xE0 h\u1EE3p nh\u1EA5t
        th\xE1nh kh\xED.\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: introDialogue.Array.data[0].text
      value: "Ng\u01B0\u01A1i nh\xECn xem... C\u1EDD c\u1EE7a Malric \u0111\xE3 c\u1EAFm
        tr\xEAn \u0111\u1EC9nh th\xE1p canh."
      objectReference: {fileID: 0}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: introDialogue.Array.data[1].text
      value: "H\u1EAFn g\u1ECDi \u0111\xF3 l\xE0 'Ng\u1ECDn l\u1EEDa Thanh l\u1ECDc',
        nh\u01B0ng ta ch\u1EC9 th\u1EA5y s\u1EF1 ph\u1EA3n b\u1ED9i ch\xE1y r\u1EF1c."
      objectReference: {fileID: 0}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: introDialogue.Array.data[2].text
      value: "Ch\xFAng ta \u0111\xE3 m\u1EA5t V\u01B0\u01A1ng Mi\u1EC7n S\u1EAFt."
      objectReference: {fileID: 0}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: introDialogue.Array.data[3].text
      value: "L\xEDnh c\u1EE7a ta \u0111\xE3 ch\u1EBFt, ho\u1EB7c \u0111\u1EA7u h\xE0ng."
      objectReference: {fileID: 0}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: introDialogue.Array.data[4].text
      value: "Gi\u1EDD \u0111\xE2y, hy v\u1ECDng duy nh\u1EA5t c\u1EE7a d\xF2ng t\u1ED9c
        l\u1EA1i n\u1EB1m trong tay m\u1ED9t... th\u1EE3 r\xE8n."
      objectReference: {fileID: 0}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: missionDialogue.Array.data[0].text
      value: "\u0110\xE2y l\xE0 Th\xE1nh Kh\xED c\u1EE7a t\u1ED5 ti\xEAn ta."
      objectReference: {fileID: 0}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: missionDialogue.Array.data[1].text
      value: "N\xF3 \u0111\xE3 v\u1EE1 n\xE1t khi ta c\u1ED1 \u0111\u1EE1 \u0111\xF2n
        c\u1EE7a t\xEAn \u0110\u1EA1i C\xF4ng T\u01B0\u1EDBc \u0111i\xEAn cu\u1ED3ng
        \u0111\xF3."
      objectReference: {fileID: 0}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: missionDialogue.Array.data[2].text
      value: "Th\xE9p th\u01B0\u1EDDng kh\xF4ng th\u1EC3 l\xE0m h\u1EAFn x\u01B0\u1EDBc
        da."
      objectReference: {fileID: 0}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: missionDialogue.Array.data[3].text
      value: "Ch\u1EC9 c\xF3 Th\xE1nh Kh\xED m\u1EDBi \u0111\u1EADp tan \u0111\u01B0\u1EE3c
        t\xE0 thu\u1EADt c\u1EE7a Malric."
      objectReference: {fileID: 0}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: missionDialogue.Array.data[4].text
      value: "N\xE0y Th\u1EE3 R\xE8n, \u0111\xF4i tay ng\u01B0\u01A1i chai s\u1EA1n
        v\xEC l\u1EEDa v\xE0 v\u0169 kh\xED, kh\xF4ng ph\u1EA3i v\xEC g\u01B0\u01A1m
        gi\xE1o."
      objectReference: {fileID: 0}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: missionDialogue.Array.data[5].text
      value: "Nh\u01B0ng l\xFAc n\xE0y, ta c\u1EA7n k\u1EF9 n\u0103ng c\u1EE7a ng\u01B0\u01A1i
        h\u01A1n b\u1EA5t k\u1EF3 hi\u1EC7p s\u0129 n\xE0o."
      objectReference: {fileID: 0}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: missionDialogue.Array.data[6].text
      value: "H\xE3y \u0111em n\xF3 \u0111\u1EBFn \u0111e r\xE8n."
      objectReference: {fileID: 0}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: missionDialogue.Array.data[7].text
      value: "H\u1ED3i ph\u1EE5c l\u1EA1i linh h\u1ED3n cho n\xF3."
      objectReference: {fileID: 0}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: missionDialogue.Array.data[8].text
      value: "\u0110\u1EEBng \u0111\u1EC3 ng\u1ECDn l\u1EEDa cu\u1ED1i c\xF9ng c\u1EE7a
        ch\xFAng ta l\u1EE5i t\xE0n."
      objectReference: {fileID: 0}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: completeDialogue.Array.data[0].text
      value: "Tuy\u1EC7t v\u1EDDi... Ng\u01B0\u01A1i th\u1EA5y kh\xF4ng? "
      objectReference: {fileID: 0}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: completeDialogue.Array.data[1].text
      value: "N\xF3 kh\xF4ng c\xF2n l\xE0 s\u1EAFt l\u1EA1nh n\u1EEFa. N\xF3 \u0111ang...
        th\u1EDF."
      objectReference: {fileID: 0}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: completeDialogue.Array.data[2].text
      value: "Ta l\xE0 ng\u01B0\u1EDDi th\u1EEBa k\u1EBF, nh\u01B0ng tay ta qu\xE1
        y\u1EBFu \u0111\u1EC3 vung n\xF3 l\xFAc n\xE0y."
      objectReference: {fileID: 0}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: completeDialogue.Array.data[3].text
      value: "Malric bi\u1EBFt c\xE1ch b\u1EBB g\xE3y \xFD ch\xED c\u1EE7a m\u1ED9t
        chi\u1EBFn binh, nh\u01B0ng h\u1EAFn s\u1EBD kh\xF4ng ng\u1EDD t\u1EDBi c\u01A1n
        th\u1ECBnh n\u1ED9 c\u1EE7a m\u1ED9t ng\u01B0\u1EDDi th\u1EE3."
      objectReference: {fileID: 0}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: completeDialogue.Array.data[4].text
      value: "C\u1EA7m l\u1EA5y n\xF3. H\xE3y d\xF9ng ch\xEDnh c\xE2y b\xFAa n\xE0y
        - th\u1EE9 \u0111\xE3 r\xE8n n\xEAn v\u01B0\u01A1ng qu\u1ED1c - \u0111\u1EC3
        \u0111\u1EADp tan xi\u1EC1ng x\xEDch c\u1EE7a k\u1EBB ph\u1EA3n b\u1ED9i."
      objectReference: {fileID: 0}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: completeDialogue.Array.data[5].text
      value: "H\xE3y l\xEAn \u0111\u1EA3o, t\xECm nh\u1EEFng m\u1EA3nh v\u1EE1 c\xF2n
        l\u1EA1i."
      objectReference: {fileID: 0}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: completeDialogue.Array.data[6].text
      value: "Ta s\u1EBD \u0111\u1EE3i tin th\u1EAFng tr\u1EADn c\u1EE7a ng\u01B0\u01A1i."
      objectReference: {fileID: 0}
    - target: {fileID: 3467983745012885446, guid: ee4528e5d428b224e928c3e4b57bdd78, type: 3}
      propertyPath: introDialogue.Array.data[0].dialogueEvent
      value: 0
      objectReference: {fileID: 0}
