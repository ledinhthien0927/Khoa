--- !u!114 &3919003259199020526
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1077886644720739728}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 459ee45e92fb4cd4b87d958b06a78f4a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::VillageChiefNPC
  npcName: "Tr\u01B0\u1EDFng L\xE0ng"
  scene1Dialogue:
  - text: "H\u1EE1i l\u1EEF kh\xE1ch ph\u01B0\u01A1ng xa, c\u1EADu \u0111\u1EBFn
      \u0111\xE2y kh\xF4ng \u0111\xFAng l\xFAc r\u1ED3i."
    dialogueEvent: 0
    eventPlayed: 0
  - text: "Ng\xF4i l\xE0ng b\xECnh y\xEAn c\u1EE7a ch\xFAng t\xF4i \u0111ang ch\u1EBFt
      d\u1EA7n."
    dialogueEvent: 0
    eventPlayed: 0
  - text: "C\xE1ch \u0111\xE2y v\xE0i ng\xE0y, m\u1ED9t v\u1EADt th\u1EC3 l\u1EA1
      t\u1EEB tr\xEAn tr\u1EDDi r\u01A1i xu\u1ED1ng khu r\u1EEBng ph\xEDa B\u1EAFc."
    dialogueEvent: 0
    eventPlayed: 0
  - text: "K\u1EC3 t\u1EEB \u0111\xF3, m\u1ED9t lu\u1ED3ng h\u1EAFc kh\xED t\xE0
      \xE1c t\u1ECFa ra t\u1EEB n\xF3."
    dialogueEvent: 0
    eventPlayed: 0
  - text: "C\xE2y c\u1ED1i bi\u1EBFn d\u1ECB, \u0111\u1EA5t \u0111ai n\u1EE9t to\xE1c,
      ngay c\u1EA3 nh\u1EEFng con th\xFA hi\u1EC1n l\xE0nh nh\u1EA5t c\u0169ng tr\u1EDF
      n\xEAn \u0111i\xEAn lo\u1EA1n v\xE0 kh\xE1t m\xE1u."
    dialogueEvent: 0
    eventPlayed: 0
  - text: "N\u1EBFu kh\xF4ng ai ph\xE1 h\u1EE7y ngu\u1ED3n n\u0103ng l\u01B0\u1EE3ng
      \u0111\xF3, h\xF2n \u0111\u1EA3o n\xE0y s\u1EBD b\u1ECB nu\u1ED1t ch\u1EEDng."
    dialogueEvent: 0
    eventPlayed: 0
  - text: "C\u1EADu c\xF3 th\u1EC3 gi\xFAp t\xF4i xua tan lu\u1ED3ng kh\xED t\xE0
      \xE1c \u0111\u01B0\u1EE3c kh\xF4ng"
    dialogueEvent: 0
    eventPlayed: 0
  warningDialogue:
    text: "C\u1EA9n th\u1EADn! H\u1EAFc kh\xED \u0111\xF3 kh\xF4ng ch\u1EC9 \u0103n
      m\xF2n th\u1EC3 x\xE1c m\xE0 c\xF2n thao t\xFAng t\xE2m tr\xED. H\xE3y b\u1EA3o
      tr\u1ECDng !"
    dialogueEvent: 0
    eventPlayed: 0
  scene2ThanksDialogue: []
  malricDialogue:
    text: 
    dialogueEvent: 0
    eventPlayed: 0
  refugeeNPC: {fileID: 0}
  scene3Dialogue: []
  finalBlessing:
    text: 
    dialogueEvent: 0
    eventPlayed: 0
  chest: {fileID: 0}
  phase: 0
